{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^mp-html": "mp-html/dist/uni-app/components/mp-html/mp-html.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "TradingAgents"
      }
    },
    {
      "path": "pages/watchlist/index",
      "style": {
        "navigationBarTitleText": "自选股"
      }
    },
    {
      "path": "pages/analysis/index",
      "style": {
        "navigationBarTitleText": "分析详情"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationBarTitleText": "历史记录"
      }
    },
    {
      "path": "pages/settings/index",
      "style": {
        "navigationBarTitleText": "设置"
      }
    },
    {
      "path": "pages/serenity/index",
      "style": {
        "navigationBarTitleText": "产业链研究"
      }
    },
    {
      "path": "pages/serenity/report",
      "style": {
        "navigationBarTitleText": "研究报告"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "TradingAgents",
    "navigationBarBackgroundColor": "#5b7cfa",
    "backgroundColor": "#f4f6fb"
  },
  "tabBar": {
    "color": "#9aa0b4",
    "selectedColor": "#4f6ef7",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/watchlist/index", "text": "自选" },
      { "pagePath": "pages/serenity/index", "text": "产业链" },
      { "pagePath": "pages/history/index", "text": "历史" }
    ]
  }
}
